{
  "name": "codenixlabs-agentready-api",
  "version": "1.0.0",
  "description": "AI Readiness Checker API for codenixlabs.com \u2014 scan engine, lead capture and report delivery.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:memory": "ts-node-dev --respawn --transpile-only src/scripts/devServer.ts",
    "build": "tsc",
    "test:privacy": "npm run build && node --test tests/privacy.cjs",
    "test:security": "npm run build && node --test tests/safeRequest.cjs",
    "start": "node dist/server.js",
    "check": "ts-node --transpile-only src/scripts/checkFixtures.ts",
    "smoke": "ts-node --transpile-only src/scripts/apiSmoke.ts",
    "scan": "ts-node --transpile-only src/scripts/scanCli.ts",
    "classify": "ts-node --transpile-only src/scripts/classifyCli.ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "mongoose": "^8.8.0",
    "resend": "^4.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "mongodb-memory-server": "^11.2.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
